<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/readerFragment">
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.storyverse.ui.library.LibraryFragment"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_libraryFragment_to_storyDetailFragment"
            app:destination="@id/storyDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment2"
        android:name="com.example.storyverse.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment2_to_exploreFragment"
            app:destination="@id/exploreFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_exploreFragment2"
            app:destination="@id/exploreFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_storyDetailFragment"
            app:destination="@id/storyDetailFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_storyDetailFragment2"
            app:destination="@id/storyDetailFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_storyDetailFragment3"
            app:destination="@id/storyDetailFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_aiFragment"
            app:destination="@id/aiFragment" />
        <action
            android:id="@+id/action_homeFragment2_to_storyDetailFragment4"
            app:destination="@id/storyDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.storyverse.ui.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.storyverse.ui.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_storyDetailFragment"
            app:destination="@id/storyDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.storyverse.ui.explore.ExploreFragment"
        android:label="fragment_explore"
        tools:layout="@layout/fragment_explore" />
    <fragment
        android:id="@+id/aiFragment"
        android:name="com.example.storyverse.ui.ai.AiFragment"
        android:label="fragment_ai"
        tools:layout="@layout/fragment_ai" />
    <fragment
        android:id="@+id/communityFragment"
        android:name="com.example.storyverse.ui.community.CommunityFragment"
        android:label="fragment_community"
        tools:layout="@layout/fragment_community" />
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.storyverse.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment2"
            app:destination="@id/homeFragment2" />
    </fragment>
    <fragment
        android:id="@+id/readerFragment"
        android:name="com.example.storyverse.ui.reader.ReaderFragment"
        android:label="fragment_reader"
        tools:layout="@layout/fragment_reader" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.storyverse.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/storyDetailFragment"
        android:name="com.example.storyverse.ui.story.StoryDetailFragment"
        android:label="fragment_story_detail"
        tools:layout="@layout/fragment_story_detail" >
        <action
            android:id="@+id/action_storyDetailFragment_to_readerFragment"
            app:destination="@id/readerFragment" />
        <action
            android:id="@+id/action_storyDetailFragment_to_communityFragment"
            app:destination="@id/communityFragment" />
    </fragment>
</navigation>