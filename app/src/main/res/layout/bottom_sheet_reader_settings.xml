<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="16dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_reader_sheet">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_reader_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TÙY CHỈNH TRẢI NGHIỆM"
        android:textColor="#8A849F"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cài đặt đọc"
        android:textColor="#25213A"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Cỡ chữ"
        android:textColor="#38334D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_font_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhỏ"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_font_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vừa"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_font_large"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lớn"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Khoảng cách dòng"
        android:textColor="#38334D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_line_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_spacing_compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gọn"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_spacing_normal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vừa"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_spacing_relaxed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thoáng"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Màu nền đọc"
        android:textColor="#38334D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_reader_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_bg_light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sáng"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_bg_cream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kem"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />

        <RadioButton
            android:id="@+id/rb_bg_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tối"
            android:textColor="#514B67"
            android:buttonTint="#7564E8" />
    </RadioGroup>

</LinearLayout>
