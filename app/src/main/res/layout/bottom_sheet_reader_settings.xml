<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_reader_sheet"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <!-- Thanh kéo -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_reader_sheet_handle" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÙY CHỈNH TRẢI NGHIỆM"
            android:textColor="#8B6BD1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Cài đặt đọc"
            android:textColor="#24212B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Điều chỉnh giao diện đọc theo sở thích của bạn"
            android:textColor="#77727F"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="#EAE6F0" />

        <!-- Cỡ chữ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cỡ chữ"
            android:textColor="#24212B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_font_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_font_small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Nhỏ"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_font_medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Vừa"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_font_large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Lớn"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#EAE6F0" />

        <!-- Khoảng cách dòng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Khoảng cách dòng"
            android:textColor="#24212B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_line_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_spacing_compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Gọn"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_spacing_normal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Vừa"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_spacing_relaxed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Thoáng"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#EAE6F0" />

        <!-- Màu nền đọc -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Màu nền đọc"
            android:textColor="#24212B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_reader_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_bg_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Sáng"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_bg_cream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Kem"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />

            <RadioButton
                android:id="@+id/rb_bg_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Tối"
                android:textColor="#77727F"
                android:textSize="13sp"
                android:buttonTint="#6842B8" />
        </RadioGroup>

    </LinearLayout>

</ScrollView>
