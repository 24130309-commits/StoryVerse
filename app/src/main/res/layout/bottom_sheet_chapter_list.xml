<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_reader_sheet">

    <!-- Thanh kéo -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_reader_sheet_handle" />

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THƯ MỤC CHƯƠNG"
        android:textColor="#8B6BD1"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Danh sách chương"
        android:textColor="#24212B"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_chapter_list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp"
        android:text="Chọn chương bạn muốn tiếp tục đọc"
        android:textColor="#77727F"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EAE6F0" />

    <!-- Danh sách chương -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chapter_list"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never" />

</LinearLayout>
