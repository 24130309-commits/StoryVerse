<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F4FC"
    android:padding="16dp"
    tools:context=".ui.search.SearchFragment">

    <!-- Tiêu đề và nút quay lại -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#7564E8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khám phá truyện"
                android:textColor="#25213A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tìm kiếm câu chuyện bạn yêu thích"
                android:textColor="#8A849F"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Thanh tìm kiếm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_reader_icon_button"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="2dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Tìm kiếm"
            app:tint="#7564E8" />

        <EditText
            android:id="@+id/edt_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="Nhập tên truyện hoặc tác giả..."
            android:textColor="#25213A"
            android:textColorHint="#A19BB2"
            android:textSize="14sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:padding="0dp" />

        <ImageView
            android:id="@+id/btnClearSearch"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Xóa từ khóa"
            android:visibility="gone"
            app:tint="#9E9E9E" />

    </LinearLayout>

    <!-- Gợi ý từ khóa và lịch sử tìm kiếm -->
    <LinearLayout
        android:id="@+id/layoutSearchSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_reader_icon_button"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSearchSuggestionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gợi ý tìm kiếm"
                android:textColor="#34304D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClearSearchHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Xóa lịch sử"
                android:textColor="#7564E8"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Bộ lọc thể loại -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSearchCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tất cả" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchTienHiep"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiên Hiệp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchNgonTinh"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngôn Tình" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchTrinhTham"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trinh Thám" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchDoThi"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đô Thị" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Tiêu đề kết quả -->
    <TextView
        android:id="@+id/tvSearchResultTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="Gợi ý tìm kiếm"
        android:textColor="#34304D"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Cảnh báo nguồn dữ liệu -->
    <TextView
        android:id="@+id/tvSearchWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFF4DE"
        android:padding="10dp"
        android:textColor="#8A5A00"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progress_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="#7564E8"
        android:visibility="gone" />

    <!-- Thông báo trạng thái -->
    <TextView
        android:id="@+id/tv_search_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Nhập tên truyện hoặc tác giả để tìm kiếm"
        android:textColor="#8A849F"
        android:textSize="14sp"
        android:visibility="visible" />

    <!-- Thử lại khi tìm kiếm lỗi -->
    <Button
        android:id="@+id/btnRetrySearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="Thử lại"
        android:textAllCaps="false"
        android:backgroundTint="#7564E8"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <!-- Danh sách kết quả -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="5"
        tools:listitem="@layout/item_story_vertical" />

</LinearLayout>
