<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F7FA"
    tools:context=".ui.reader.ReaderFragment">

    <!-- Reader header -->
    <LinearLayout
        android:id="@+id/reader_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_reader_toolbar"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="11dp"
            android:src="@drawable/ic_reader_back"
            android:tint="#24212B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reader_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Đang đọc truyện"
                android:textColor="#24212B"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="KHÔNG GIAN ĐỌC STORYVERSE"
                android:textColor="#8B6BD1"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chapter_list"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_reader_icon_button"
            android:contentDescription="Mở danh sách chương"
            android:padding="11dp"
            android:src="@drawable/ic_reader_chapters"
            android:tint="#6842B8" />

        <ImageButton
            android:id="@+id/btn_reader_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cài đặt đọc"
            android:padding="11dp"
            android:src="@drawable/ic_reader_settings"
            android:tint="#514B67" />

    </LinearLayout>

    <!-- Reading progress -->
    <ProgressBar
        android:id="@+id/progress_reading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#EAE6F0"
        android:progressTint="#6842B8" />

    <!-- Reader content -->
    <FrameLayout
        android:id="@+id/reader_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp"
            android:scrollbarStyle="outsideOverlay"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chapter_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#F0EAFB"
                    android:paddingStart="13dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="7dp"
                    android:text="CHƯƠNG 1"
                    android:textColor="#6842B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tv_chapter_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tên chương"
                    android:textColor="#24212B"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="28dp"
                    android:background="#8B6BD1" />

                <TextView
                    android:id="@+id/tv_chapter_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:lineSpacingExtra="9dp"
                    android:text="Nội dung chương truyện sẽ được hiển thị ở đây."
                    android:textColor="#34313D"
                    android:textSize="17sp"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="normal"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/tv_reader_attribution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:paddingTop="16dp"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#77727F"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/reader_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#F8F7FA"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_reader_loading"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:indeterminate="true"
                android:indeterminateTint="#6842B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Đang tải nội dung chương..."
                android:textColor="#77727F"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Error and empty state -->
        <LinearLayout
            android:id="@+id/reader_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="#F8F7FA"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="Thông báo"
                android:tint="#8B6BD1" />

            <TextView
                android:id="@+id/tv_reader_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Không thể tải nội dung truyện."
                android:textColor="#514B67"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reader_retry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Thử lại"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:backgroundTint="#6842B8" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom chapter navigation -->
    <LinearLayout
        android:id="@+id/reader_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="78dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous_chapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="‹  Chương trước"
            android:textAllCaps="false"
            android:textColor="#6842B8"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:strokeColor="#6842B8"
            app:strokeWidth="1dp"
            app:backgroundTint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_chapter_progress"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 / 10"
            android:textColor="#77727F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next_chapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Chương sau  ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:backgroundTint="#6842B8" />

    </LinearLayout>

</LinearLayout>
