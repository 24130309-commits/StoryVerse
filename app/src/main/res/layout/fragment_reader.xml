<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F4FC"
    tools:context=".ui.reader.ReaderFragment">

    <LinearLayout
        android:id="@+id/reader_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@drawable/bg_reader_toolbar"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="11dp"
            android:src="@drawable/ic_reader_back"
            android:tint="#34304D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reader_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Đang đọc truyện"
                android:textColor="#25213A"
                android:textSize="15sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="KHÔNG GIAN ĐỌC STORYVERSE"
                android:textColor="#8A849F"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chapter_list"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_reader_icon_button"
            android:contentDescription="Mở danh sách chương"
            android:padding="11dp"
            android:src="@drawable/ic_reader_chapters"
            android:tint="#6654D9" />

        <ImageButton
            android:id="@+id/btn_reader_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cài đặt đọc"
            android:padding="11dp"
            android:src="@drawable/ic_reader_settings"
            android:tint="#514B67" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_reading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#E5E1F0"
        android:progressTint="#7564E8" />

    <ScrollView
        android:id="@+id/scroll_reader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chapter_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reader_chapter_label"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="CHƯƠNG 1"
                android:textColor="#6654D9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/tv_chapter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tên chương"
                android:textColor="#25213A"
                android:textSize="25sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="54dp"
                android:layout_height="3dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="26dp"
                android:background="@drawable/bg_reader_accent_line" />

            <TextView
                android:id="@+id/tv_chapter_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="9dp"
                android:text="Nội dung chương truyện sẽ được hiển thị ở đây."
                android:textColor="#383445"
                android:textSize="17sp"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="normal"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/tv_reader_attribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingTop="14dp"
                android:autoLink="web"
                android:linksClickable="true"
                android:lineSpacingExtra="3dp"
                android:textColor="#827D91"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/reader_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="78dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_reader_bottom_bar"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous_chapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="‹  Chương trước"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:backgroundTint="#7564E8" />

        <TextView
            android:id="@+id/tv_chapter_progress"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1 / 10"
            android:textColor="#77718B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next_chapter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Chương sau  ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:backgroundTint="#7564E8" />
    </LinearLayout>
</LinearLayout>
